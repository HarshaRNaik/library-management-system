[Unit]
Description=Library Management System API
After=network.target

[Service]
Type=simple
User={{ app_user }}
Group={{ app_group }}
WorkingDirectory={{ app_directory }}
Environment=NODE_ENV={{ app_environment }}
Environment=PORT={{ app_port }}
Environment=HOST={{ app_host }}
ExecStart=/usr/bin/node {{ app_directory }}/src/server.js
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
